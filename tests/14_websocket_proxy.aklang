; lib/ws (Ak 0.7.33): echo server in Ak, directly and through an http:// proxy (CONNECT). The proxy logs what it tunnelled.
(use "../ak/lib/ws.aklang" as w)
(use "t.aklang" as t)
url=(++ "ws://127.0.0.1:" (env "WS_PORT") "/")
ws=(w.connect url {:ms 3000 :rms 3000})
(w.send ws "hello")
(t.check "text echo" (== (w.recv ws) "hello"))
(w.sendb ws "bin")
m=(w.recv ws)
(t.check "binary echo keeps its kind" (&& (== m "bin") ws.bin))
(w.send ws (rpt "x" 100000))
(t.check "100 KB message" (== #(w.recv ws) 100000))
(w.send ws "close")
(t.check "server closes with 1000" (&& (== (w.recv ws) nil) ws.closed (== ws.code 1000)))
log=(env "PXPLAIN_LOG")
px=(++ "http://127.0.0.1:" (env "PXPLAIN_PORT"))
ws=(w.connect url {:ms 3000 :rms 3000 :proxy px})
(w.send ws "via proxy")
(t.check "echo through the CONNECT proxy" (== (w.recv ws) "via proxy"))
(t.check "the proxy tunnelled the connection" (has (rd log) (++ "CONNECT 127.0.0.1:" (env "WS_PORT"))))
(w.send ws "close") (w.recv ws)
e=(try (w.connect url {:ms 1000 :rms 1000 :proxy "http://127.0.0.1:9"}) x=>x)
(t.check "an unreachable proxy is an error" (isstr e))
t.done()

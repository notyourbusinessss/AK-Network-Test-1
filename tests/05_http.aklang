; HTTP client (lib/http) against an Ak-written HTTP/1.1 server: GET, POST, JSON, redirects, chunked, 2 MB body, status codes, headers, custom headers, errors.
(use "../lib/http.aklang" as h)
(use "t.aklang" as t)
base=(++ "http://127.0.0.1:" (env "HTTP_PORT"))
r=(h.get (++ base "/"))
(t.check "GET / -> 200" r.status==200)
(t.check "GET / body" r.body=="hello from Ak")
(t.check "response header names are lower case" (has (keys r.headers) "content-type"))
(t.check "GET with a path" (h.get (++ base "/echo/abc")).body=="abc")
(t.check "GET with a query string reaches the server" (h.get (++ base "/echo/q?x=1")).body=="q?x=1")
j=(unjson (h.get (++ base "/json")).body)
(t.check "JSON body parses" (&& j.ok==true j.n==42))
(t.check "302 redirect is followed" (h.get (++ base "/redirect")).body=="redirected")
(t.check "chunked body is reassembled" (h.get (++ base "/chunked")).body=="hello world")
(t.check "404 is returned, not raised" (h.get (++ base "/nope")).status==404)
(t.check "503 is returned, not raised" (h.get (++ base "/status/503")).status==503)
big=(h.get (++ base "/big"))
(t.check "2 MB body arrives complete" #big.body==2097152)
p1=(h.post (++ base "/post") "send me back")
(t.check "POST body reaches the server" p1.body=="SEND ME BACK")
p2=(h.post (++ base "/post") (json {:a 1}) {"Content-Type" "application/json"})
(t.check "POST with a header" p2.body=="{\"A\":1}")
(t.check "req with an explicit method" (h.req "GET" (++ base "/echo/m") nil {}).body=="m")
e=(try (h.get "http://127.0.0.1:1/") x=>(errkind x))
(t.check "connection refused raises an io error" e=="io")
e=(try (h.get (++ base "/trunc")) x=>(errkind x))
(t.check "truncated body raises an io error" e=="io")
e=(try (h.get "ftp://example.com/") x=>x)
(t.check "unsupported scheme is rejected" (has e "unsupported URL"))
e=(try (h.get "http://nonexistent.test/") x=>x)
(t.check "unresolvable host raises" (isstr e))
(t.done)

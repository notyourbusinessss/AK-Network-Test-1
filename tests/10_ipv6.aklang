; IPv6 (Ak 0.7+): TCP, UDP and DNS literals on ::1. Skips when this machine has no IPv6 loopback (containers often have none).
(use "t.aklang" as t)
l=(try (tcpl 0 "::1") e=>e)
(? (isstr l)
   (: (t.check "without IPv6, listening on ::1 is a clean io error" (|| (has l "IPv6") (has l "cannot listen")))
      (p "SKIP no IPv6 loopback on this machine"))
   (: port=(tcpp l)
      c=(tcpc "::1" port) s=(tcpa l)
      (fdw c "ping") (t.check "TCP client to server over ::1" (== (fdr s 10) "ping"))
      (fdw s "pong") (t.check "TCP server to client over ::1" (== (fdr c 10) "pong"))
      (t.check "peer reports ::1" (has (tostr (peer c).ip) "1"))
      (fdc c) (fdc s) (fdc l)
      l2=(tcpl 0 "::") p2=(tcpp l2)
      c4=(tcpc "127.0.0.1" p2) s4=(tcpa l2)
      (fdw c4 "v4") (t.check "a :: listener also takes IPv4 clients" (== (fdr s4 10) "v4"))
      (fdc c4) (fdc s4) (fdc l2)
      u=(udpl 0 "::1") up=(tcpp u) uc=(udp)
      (udpto uc "::1" up "v6 hello")
      [d ip pt]=(udpfrom2 u 100 2000)
      (t.check "UDP over ::1: datagram and sender arrive" (&& (== d "v6 hello") (> pt 0)))
      (udpto u ip pt "echo")
      (t.check "UDP answer to the sender" (== (udpfrom uc 100 2000) "echo"))
      (fdc u) (fdc uc)
      (t.check "an IPv6 literal resolves to itself" (== (dns "::1") ["::1"]))))
t.done()

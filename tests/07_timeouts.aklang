; Timeouts and failure modes: connect timeout, fdwait as a read timeout, a server that never answers, a peer that hangs up mid-response.
(use "t.aklang" as t)
l=(tcpl 0 "127.0.0.1")
c=(tcpc "127.0.0.1" (tcpp l))
s=(tcpa l)
t0=(clock)
ready=(fdwait [c] 300)
dt=(clock)-t0
(t.check "fdwait with nothing to read returns [] after ms" (&& ready==[] dt>=250 dt<1500))
(fdw s "x")
(t.check "fdwait returns the readable fd" (fdwait [c] 1000)==[c])
(fdr c)
(fdc s)
(t.check "fdwait reports a closed peer as readable" (fdwait [c] 1000)==[c])
(t.check "read after peer close gives end of stream" (fdr c)=="")
(fdc c) (fdc l)
; a server that never answers: we cannot set a socket read timeout (see README), but fdwait gives the same effect
c=(tcpc "127.0.0.1" (num (env "SLOW_PORT")))
(fdw c "GET /slow HTTP/1.1\r\nHost: x\r\n\r\n")
t0=(clock)
(t.check "request to a silent server times out via fdwait" (fdwait [c] 400)==[])
(t.check "...after about 400 ms" (&& (clock)-t0>=350 (clock)-t0<2000))
(fdc c)
(t.done)

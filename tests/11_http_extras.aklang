; lib/http features of Ak 0.7: connection reuse (:pool), gzip/deflate (:gzip), proxies (:proxy), against fixtures/web.py (HTTP/1.1 keep-alive).
(use "../ak/lib/http.aklang" as h)
(use "t.aklang" as t)
base=(++ "http://127.0.0.1:" (env "WEB_PORT"))
(= (conns) (num (h.get (++ base "/conns")).body))
n0=(conns)
(= (dn) (- (conns) n0))
; without a pool every request opens a connection (the /conns request itself counts too)
(h.get (++ base "/hello")) (h.get (++ base "/hello"))
(t.check "no pool: each request is its own connection" (>= (dn) 3))
pool=h.session()
n0=(conns)
(for i 5 (h.get (++ base "/hello") nil {:pool pool}))
n1=(conns)
(t.check "pool: five requests share one connection (+1 for the /conns call)" (== (- n1 n0) 2))
(t.check "pooled replies are intact" (== (h.get (++ base "/hello") nil {:pool pool}).body "hello"))
(h.release pool)
; compression
r=(h.get (++ base "/gz") nil {:gzip true})
(t.check "gzip body is decoded" (== r.body (rpt "abc" 5000)))
r=(h.get (++ base "/deflate") nil {:gzip true})
(t.check "deflate body is decoded" (== r.body (rpt "abc" 5000)))
r=(h.get (++ base "/gz"))
(t.check "without :gzip the body stays compressed" (&& (> #r.body 0) (< #r.body 200) (!= r.body (rpt "abc" 5000))))
; proxies: the server answers any absolute-URI request with the URI it saw. HTTP_PROXY never applies to loopback hosts, but an explicit {:proxy url} does; here it is given a name that is only in the proxy's eyes.
px=(++ "http://u:pw@127.0.0.1:" (env "WEB_PORT"))
r=(h.get "http://example.invalid/some/path" nil {:proxy px})
(t.check "HTTP through a proxy sends the absolute URI" (&& r.status==200 (starts r.body "proxied http://example.invalid/some/path")))
(t.check "proxy credentials become Proxy-Authorization" (has r.body "auth=Basic dTpwdw=="))
r=(h.get (++ base "/hello") nil {:proxy px})
(t.check "an explicit :proxy is used even for a loopback target (only HTTP_PROXY/NO_PROXY exempt loopback)" (starts r.body "proxied http://127.0.0.1:"))
e=(try (h.get "http://example.invalid/" nil {:proxy false :ms 500}) x=>x)
(t.check "{:proxy false} connects directly (and fails to resolve)" (isstr e))
t.done()

; HTTPS and TLS 1.3 against a local Node TLS server with a throw-away CA (the only trust root given to Ak): success, big body, wrong name, untrusted CA, TLS 1.2-only server.
(use "../lib/http.aklang" as h)
(use "../lib/pki.aklang" as k)
(use "t.aklang" as t)
roots=(~ x=>(k.cert_parse x) (k.pem_certs (rd (env "CA_PEM"))))
other=(~ x=>(k.cert_parse x) (k.pem_certs (rd (env "OTHER_PEM"))))
ok=(++ "https://localhost:" (env "TLS_PORT"))
r=(h.get (++ ok "/") nil {:roots roots})
(t.check "HTTPS GET with a custom CA" (&& r.status==200 r.body=="hello over tls"))
r=(h.get (++ ok "/big") nil {:roots roots})
(t.check "1 MB over TLS" #r.body==1048576)
e=(try (h.get (++ "https://127.0.0.1:" (env "TLS_PORT") "/") nil {:roots roots}) x=>x)
(t.check "wrong host name is rejected" (has e "does not match"))
e=(try (h.get (++ ok "/") nil {:roots other}) x=>x)
(t.check "untrusted CA is rejected" (has e "trusted issuer"))
e=(try (h.get (++ "https://localhost:" (env "TLS12_PORT") "/") nil {:roots roots}) x=>x)
(t.check "TLS 1.2-only server is rejected" (has e "tls"))
; Not tested: an https URL on a plain HTTP port. The handshake has no read timeout (only :ms for connect), so it waits forever for a server that waits for the client: see README.
(t.done)

; lib/tls as a server (Ak 0.7+), Ak client against an Ak TLS server (fixtures/tls_ak.aklang): SNI, ALPN, client certificates, session resumption; TLS 1.2 resumption against Node.
(use "../ak/lib/tls.aklang" as tl)
(use "../ak/lib/pki.aklang" as k)
(use "t.aklang" as t)
roots=(~ x=>(k.cert_parse x) (k.pem_certs (rd (env "CA_PEM"))))
(= (talk port o)                        ; connect, send a request, read until the end; [reply connection]
  cn=(tl.connect "localhost" (num port) o)
  (tl.write cn "GET / HTTP/1.0\r\n\r\n")
  out="" d=nil (wh d!="" d=(tl.read cn) out+=d)
  [out cn])
[r cn]=(talk (env "AKTLS_PORT") {:roots roots})
(t.check "Ak client talks to Ak TLS server, server sees the SNI name" (has r "hello sni=localhost"))
(t.check "no client certificate: server reports peer=no" (has r "peer=no"))
(t.check "no ALPN offered: none negotiated" (&& (has r "alpn=-") (== cn.alpn nil)))
(tl.close cn)
[r cn]=(talk (env "AKTLS_PORT") {:roots roots :alpn ["h2" "http/1.1"]})
(t.check "ALPN: the server picks h2" (&& (has r "alpn=h2") (== cn.alpn "h2")))
(tl.close cn)
[r cn]=(talk (env "AKTLS_PORT") {:roots roots :alpn ["http/1.1"]})
(t.check "ALPN: the common protocol is http/1.1" (== cn.alpn "http/1.1"))
(tl.close cn)
e=(try (talk (env "AKTLS_PORT") {:roots roots :alpn ["spdy/3"]}) x=>x)
(t.check "ALPN with nothing in common is refused" (isstr e))
; client certificates
e=(try (talk (env "MTLS_PORT") {:roots roots}) x=>x)
(t.check "server requiring a client certificate refuses a client without one" (isstr e))
[r cn]=(talk (env "MTLS_PORT") {:roots roots :cert (rd (env "CLIENT_PEM")) :key (rd (env "CLIENT_KEY"))})
(t.check "client certificate accepted: server reports peer=yes" (has r "peer=yes"))
(tl.close cn)
; TLS 1.3 session resumption: the ticket arrives after the handshake, so read first
[r cn]=(talk (env "AKTLS_PORT") {:roots roots})
s=(tl.session cn)
(tl.close cn)
(t.check "the first connection is a full handshake and yields a session" (&& (! cn.resumed) (!= s nil)))
[r cn]=(talk (env "AKTLS_PORT") {:roots roots :session s})
(t.check "TLS 1.3 session resumption" (&& cn.resumed (has r "resumed")))
(tl.close cn)
; TLS 1.2 (Node, TLS 1.2 only): session tickets
[r cn]=(talk (env "TLS12_PORT") {:roots roots})
s=(tl.session cn)
(tl.close cn)
(t.check "TLS 1.2 handshake works" (has r "HTTP/1.1 200"))
(t.check "TLS 1.2 yields a session ticket" (&& (!= s nil) s.v12))
[r cn]=(talk (env "TLS12_PORT") {:roots roots :session s})
(t.check "TLS 1.2 session resumption" cn.resumed)
(tl.close cn)
t.done()

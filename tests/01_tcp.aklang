; TCP client and server in one process: connect, accept, request/response, half close, close detection, connection refused, connect timeout.
(use "t.aklang" as t)
l=(tcpl 0 "127.0.0.1")
port=(tcpp l)
(t.check "listen on port 0 picks a port" port>0)
c=(tcpc "127.0.0.1" port)
s=(tcpa l)
(fdw c "ping")
(t.check "server reads what the client wrote" (fdr s)=="ping")
(fdw s "pong")
(t.check "client reads the reply" (fdr c)=="pong")
(fdw c (rpt "x" 1000))
(t.check "1000 byte write arrives" #(fdr s)==1000)
(fdc c)
(t.check "server sees end of stream after the client closes" (fdr s)=="")
(fdc s)
(fdc l)
r=(try (: (tcpc "127.0.0.1" port 1000) "connected") e=>(++ "error " (errkind e)))
(t.check "connecting to a closed port raises an io error" r=="error io")
; a binary-safe round trip of every byte value
l=(tcpl 0 "127.0.0.1")
c=(tcpc "localhost" (tcpp l))
s=(tcpa l)
bytes=(~ i=>i (0..256))
(fdw c bytes)
got=[] (wh #got<256 d=(fdr s) (? d=="" (raise "io" "early eof")) got=[..got ..(~ ch=>(ord ch) d)])
(t.check "256 byte values written as a byte list arrive" #got==256)
(fdc c) (fdc s) (fdc l)
; connect timeout: a non-routable address must give up after ms
t0=(clock)
r=(try (: (tcpc "10.255.255.1" 81 300) "connected") e=>"error")
dt=(clock)-t0
(t.check "connect to an unroutable address fails within the timeout" (&& r=="error" dt<3000))
(t.done)

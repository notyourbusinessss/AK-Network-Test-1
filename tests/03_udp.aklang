; UDP client against a Python echo server (Ak cannot bind a UDP socket, so it cannot be the server): round trips, datagram boundaries, 60 KB datagram, receive timeout.
(use "t.aklang" as t)
port=(num (env "ECHO_PORT"))
u=(udp)
(udpto u "127.0.0.1" port "hello")
(t.check "echo of a datagram" (udpfrom u 100 2000)=="hello")
(for i 3 (udpto u "127.0.0.1" port (++ "msg" i)))
got=[(udpfrom u 100 2000) (udpfrom u 100 2000) (udpfrom u 100 2000)]
(t.check "datagram boundaries are kept" got==["msg0" "msg1" "msg2"])
(udpto u "127.0.0.1" port "")
(t.check "empty datagram round trip" (udpfrom u 100 2000)=="")
big=(rpt "x" 60000)
(udpto u "127.0.0.1" port big)
(t.check "60000 byte datagram round trip" #(udpfrom u 70000 2000)==60000)
(udpto u "127.0.0.1" port "abcdefgh")
(t.check "udpfrom n smaller than the datagram truncates it (like recvfrom(3))" (udpfrom u 3 2000)=="abc")
(udpto u "127.0.0.1" port "binary \x00\x01\xff")
(t.check "binary payload with NUL survives" #(udpfrom u 100 2000)>=9)
t0=(clock)
r=(udpfrom u 100 200)
dt=(clock)-t0
(t.check "udpfrom returns nil after its timeout" (&& r==nil dt>=150 dt<1500))
two=(udp)
(udpto two "127.0.0.1" port "from two")
(t.check "second socket gets its own reply" (udpfrom two 100 2000)=="from two")
(t.check "first socket did not get the other reply" (udpfrom u 100 100)==nil)
(fdc u) (fdc two)
t.done()

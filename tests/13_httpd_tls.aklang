; lib/httpd serving https (Ak 0.7.34): {:tls {:cert :key}}, req.sni, handshake failures (fixtures/httpd_tls.aklang)
(use "../ak/lib/http.aklang" as h)
(use "../ak/lib/pki.aklang" as k)
(use "t.aklang" as t)
roots=(~ x=>(k.cert_parse x) (k.pem_certs (rd (env "CA_PEM"))))
base=(++ "localhost:" (env "HTTPDTLS_PORT"))
r=(h.get (++ "https://" base "/") nil {:roots roots})
(t.check "GET over TLS; req.sni is the name the client asked for" (&& r.status==200 r.body=="hello localhost GET:"))
r=(h.post (++ "https://" base "/p") "some body" nil {:roots roots})
(t.check "POST body arrives" (== r.body "hello localhost POST:some body"))
pool=h.session()
r1=(h.get (++ "https://" base "/") nil {:roots roots :pool pool})
r2=(h.get (++ "https://" base "/") nil {:roots roots :pool pool})
(h.release pool)
(t.check "keep-alive over TLS: two requests on one pooled connection" (&& r1.status==200 r2.status==200))
e=(try (h.get (++ "https://127.0.0.1:" (env "HTTPDTLS_PORT") "/") nil {:roots roots}) x=>x)
(t.check "wrong host name is rejected" (&& (isstr e) (has e "does not match")))
e=(try (h.get (++ "https://" base "/") nil {:roots (~ x=>(k.cert_parse x) (k.pem_certs (rd (env "OTHER_PEM"))))}) x=>x)
(t.check "untrusted CA is rejected" (isstr e))
e=(try (h.get (++ "http://" base "/") nil {:rms 2000 :ms 2000}) x=>x)
(t.check "plain http to the TLS port fails cleanly" (isstr e))
r=(h.get (++ "https://" base "/") nil {:roots roots})
(t.check "the server survives the failed handshakes" (== r.status 200))
t.done()

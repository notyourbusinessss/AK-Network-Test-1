; HTTP/2 client (Ak 0.7.35): {:h2 true} offers h2 by ALPN. Node's http2 server (fixtures/h2_server.js) answers "<http version> <method> <path> <body bytes>".
(use "../ak/lib/http.aklang" as h)
(use "../ak/lib/pki.aklang" as k)
(use "t.aklang" as t)
roots=(~ x=>(k.cert_parse x) (k.pem_certs (rd (env "CA_PEM"))))
base=(++ "https://localhost:" (env "H2_PORT"))
o={:roots roots :h2 true :rms 10000}
r=(h.get (++ base "/a?b=1") {"X-Test" "yes"} o)
(t.check "GET over HTTP/2" (&& r.status==200 r.body=="2.0 GET /a?b=1 0" (has r.headers "x-h2")))
(t.check "request header arrives, repeated response headers are kept" (&& r.headers["x-got"]=="yes" (has r.headers["set-cookie"] "b=2")))
r=(h.post (++ base "/up") (rpt "0123456789" 20000) nil o)
(t.check "200000 byte POST (over the 65535 flow-control window)" (== r.body "2.0 POST /up 200000"))
r=(h.get (++ base "/big") nil o)
(t.check "3 MB reply" (&& r.status==200 #r.body==3000000))
r=(h.get (++ base "/redir") nil o)
(t.check "redirect followed" (== r.body "2.0 GET /after 0"))
r=(h.req "HEAD" (++ base "/") nil nil o)
(t.check "HEAD has no body" (&& r.status==200 r.body==""))
r=(h.get (++ base "/x") nil {:roots roots :rms 10000})
(t.check "without :h2 the same server is spoken to in HTTP/1.1" (&& (== r.body "1.1 GET /x 0") (! (has r.headers "x-h2"))))
r=(h.get (++ "https://localhost:" (env "TLS_PORT") "/") nil o)
(t.check ":h2 against a server without h2 falls back to HTTP/1.1" (== r.body "hello over tls"))
r=(h.get (++ base "/via") nil {:roots roots :h2 true :rms 10000 :proxy (++ "https://localhost:" (env "PXTLS_PORT"))})
(t.check "HTTP/2 through an https proxy tunnel" (&& r.body=="2.0 GET /via 0"))
e=(try (h.get (++ "https://127.0.0.1:" (env "H2_PORT") "/") nil o) x=>x)
(t.check "wrong host name is rejected over HTTP/2" (&& (isstr e) (has e "does not match")))
t.done()

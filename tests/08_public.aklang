; Public internet: real DNS, HTTP and HTTPS with the system CA bundle. Prints SKIP (exit 0) when there is no direct network access.
(use "../lib/http.aklang" as h)
(use "t.aklang" as t)
addrs=(try (dns "example.com") e=>nil)
(? addrs==nil (: (p "SKIP no DNS / no direct internet from this machine") (exit 0)))
(t.check "dns example.com gives IPv4 addresses" (&& #addrs>0 (re "^[0-9.]+$" addrs[0])))
r=(h.get "http://example.com/")
(t.check "http://example.com -> 200 (or a redirect to https)" (|| r.status==200 r.status==301))
r=(h.get "https://example.com/")
(t.check "https://example.com -> 200" r.status==200)
(t.check "https body mentions Example Domain" (has r.body "Example Domain"))
r=(h.get "https://www.google.com/")
(t.check "https://www.google.com -> 200 (TLS 1.3, system roots)" r.status==200)
e=(try (h.get "https://expired.badssl.com/") x=>x)
(t.check "expired certificate is rejected" (isstr e))
e=(try (h.get "https://self-signed.badssl.com/") x=>x)
(t.check "self-signed certificate is rejected" (isstr e))
r=(try (h.get "https://example.com:81/" nil {:ms 1500}) x=>"timeout")
(t.check "blocked port fails within the connect timeout" (== r "timeout"))
(t.done)

; https:// proxies (Ak 0.7.32): TLS to the proxy, CONNECT through it, TLS to the target inside (fixtures/proxy.aklang tls). The proxy logs what it was asked.
(use "../ak/lib/http.aklang" as h)
(use "../ak/lib/pki.aklang" as k)
(use "t.aklang" as t)
roots=(~ x=>(k.cert_parse x) (k.pem_certs (rd (env "CA_PEM"))))
other=(~ x=>(k.cert_parse x) (k.pem_certs (rd (env "OTHER_PEM"))))
log=(env "PXTLS_LOG")
px=(++ "https://localhost:" (env "PXTLS_PORT"))
r=(h.get (++ "https://localhost:" (env "TLS_PORT") "/") nil {:roots roots :proxy px})
(t.check "https target through an https proxy (TLS inside TLS)" (&& r.status==200 r.body=="hello over tls"))
(t.check "the proxy saw a CONNECT to the target" (has (rd log) (++ "CONNECT localhost:" (env "TLS_PORT"))))
r=(h.get (++ "https://localhost:" (env "TLS_PORT") "/big") nil {:roots roots :proxy px})
(t.check "1 MB through the tunnel" #r.body==1048576)
r=(h.get (++ "http://example.invalid/x") nil {:roots roots :proxy px})
(t.check "http target through an https proxy: absolute URI request over TLS" (&& r.status==200 (has r.body "proxied GET http://example.invalid/x")))
e=(try (h.get (++ "https://localhost:" (env "TLS_PORT") "/") nil {:roots roots :proxy (++ "https://127.0.0.1:" (env "PXTLS_PORT"))}) x=>x)
(t.check "proxy certificate for another name is rejected" (&& (isstr e) (has e "does not match")))
e=(try (h.get (++ "https://localhost:" (env "TLS_PORT") "/") nil {:roots other :proxy px}) x=>x)
(t.check "proxy certificate from an untrusted CA is rejected" (isstr e))
; the target's certificate is still checked inside the tunnel: a wrong name must fail even though the proxy is fine
e=(try (h.get (++ "https://127.0.0.1:" (env "TLS_PORT") "/") nil {:roots roots :proxy px}) x=>x)
(t.check "target certificate is verified inside the tunnel" (&& (isstr e) (has e "does not match")))
t.done()

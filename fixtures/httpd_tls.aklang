; lib/httpd serving https: ak fixtures/httpd_tls.aklang cert.pem key.pem portfile
; replies "hello <sni> <method>:<body>" (sni is the client's server name)
(use "../ak/lib/httpd.aklang" as s)
[cert key portfile]=(args)
l=(s.listen 0 (\ (rq) (++ "hello " (?? rq.sni "-") " " rq.method ":" (?? rq.body ""))) {:tls {:cert (rd cert) :key (rd key)} :headms 1500})
(wr portfile (tostr (tcpp l)))
s.run()
